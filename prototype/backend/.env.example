# Copy to .env before running:  cp .env.example .env

# Local MongoDB. The prototype expects mongod running on the default port.
MONGODB_URI=mongodb://localhost:27017/magtapp

# Signing key for access tokens. Any string works locally; in a real
# deployment this comes from a secret manager and rotating it logs everyone out.
JWT_SECRET=dev-only-change-me

# Port the Express server listens on.
PORT=4000
